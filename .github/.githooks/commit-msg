#!/bin/sh

set -e

echo "🔍 Validando mensagem de commit..."
echo ""

if ! npx --no-install commitlint --edit "$1"; then
  echo ""
  echo " Commit inválido."
  echo ""
  echo " Use o padrão Conventional Commits:"
  echo ""
  echo "  feat: adiciona autenticação JWT"
  echo "  fix: corrige erro na criação de notícia"
  echo "  refactor: melhora organização das actions"
  echo "  chore: ajusta configuração do Docker"
  echo "  ci: adiciona pipeline do GitHub Actions"
  echo ""
  echo "  Tipos aceitos:"
  echo "  feat, fix, docs, style, refactor, test, chore, ci"
  echo ""
  exit 1
fi

echo ""
echo "Commit válido!"